FABRYKA_DATABASE_URL=postgresql+psycopg://fabryka:fabryka@localhost:5432/fabryka
FABRYKA_API_URL=http://localhost:8000
FABRYKA_RUNNER_IMAGE=dawidmkrk/dmpod-gpt:1.0
# Optional Cloudflare R2 (local artifact storage is used when unset)
FABRYKA_R2_ENDPOINT=
FABRYKA_R2_BUCKET=
FABRYKA_R2_ACCESS_KEY=
FABRYKA_R2_SECRET_KEY=

# SDK client only: generate a personal key in /#account.
# FABRYKA_API_KEY=

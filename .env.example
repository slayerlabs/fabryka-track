FABRYKA_DATABASE_URL=postgresql+psycopg://fabryka:fabryka@localhost:5432/fabryka
FABRYKA_API_URL=http://localhost:8000
FABRYKA_RUNNER_IMAGE=dawidmkrk/dmpod-gpt:1.0
# Compose deployment only: persistent host directory mounted into the app.
FABRYKA_ARTIFACT_PATH=./artifacts
# Optional Cloudflare R2 (local artifact storage is used when unset)
FABRYKA_R2_ENDPOINT=
FABRYKA_R2_BUCKET=
FABRYKA_R2_ACCESS_KEY=
FABRYKA_R2_SECRET_KEY=

# SDK client only: generate a personal key in /#account.
# FABRYKA_API_KEY=

# Public HTTPS origin for Hugging Face OAuth CIMD and callback.
FABRYKA_PUBLIC_URL=https://contest.fabryka.ai

# RunPod keys stay on the server. Only these existing accounts may spend GPU credits.
FABRYKA_RUNPOD_API_KEY=
FABRYKA_RUNPOD_ALLOWED_USERS=
FABRYKA_RUNPOD_GPU_TYPE=NVIDIA RTX A5000
FABRYKA_RUNPOD_CLOUD_TYPE=SECURE
FABRYKA_RUNPOD_MAX_SECONDS=3600
FABRYKA_RUNPOD_MAX_HOURLY_USD=0.50
